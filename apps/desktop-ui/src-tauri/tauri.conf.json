{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RADsuite",
  "version": "0.2.0",
  "identifier": "nz.radsuite.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RADsuite",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$HOME/Library/Application Support/RADsuite/**",
          "$HOME/Library/Application Support/RADsuite.RADsuite/**",
          "$HOME/Library/Application Support/nz.RADsuite.RADsuite/**",
          "$HOME/.local/share/RADsuite/**",
          "$HOME/AppData/Roaming/RADsuite/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "windows": {
      "digestAlgorithm": "sha256"
    }
  }
}
